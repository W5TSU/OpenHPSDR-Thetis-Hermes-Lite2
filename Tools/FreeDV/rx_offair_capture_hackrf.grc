- name: out_file
  id: parameter
  parameters:
    alias: ''
    comment: Captured mono USB audio, 8 kHz float32 wav. Rename per capture (this
      does NOT auto-timestamp) so successive test runs don't overwrite each other
      -- e.g. offair_tx_radev1_<date>.wav vs offair_tx_700e_<date>.wav, matching this
      repo's convention of a descriptive name over a bare default (see offair_14236000_RADEV1_20260808.wav).
    hide: none
    label: Output wav (captured demodulated audio)
    short_id: ''
    type: str
    value: '"offair_capture.wav"'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [776, 16.0]
    rotation: 0
    state: enabled
