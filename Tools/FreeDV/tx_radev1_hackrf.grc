- name: rational_resampler_xxx_0
  id: rational_resampler_xxx
  parameters:
    affinity: ''
    alias: ''
    comment: 48 kHz -> samp_rate (2.4 Msps default), so the RADE V1 signal lands
      safely inside the HackRF's much wider Nyquist band without aliasing.
    decim: '1'
    fbw: '0'
    interp: '50'
    maxoutbuf: '0'
    minoutbuf: '0'
    taps: '[]'
    type: ccc
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [624, 220.0]
    rotation: 0
    state: enabled
- name: blocks_conjugate_cc_0
  id: blocks_conjugate_cc
  parameters:
    affinity: ''
    alias: ''
    comment: 'Sideband fix, ported from tx_700e_hackrf.grc''s 2026-08-15 finding:
      make_fdv_test_iq.py''s own conjugate (-iq.imag) was calibrated for
      Quick-Play''s direct injection point, but the HackRF TX + HL2 RX mixer
      stages apparently add one more spectral inversion on top of that -- this
      re-conjugates to cancel it back out and land correctly on USB/DIGU, same
      as every other place in this repo assumes. Applied here from the start
      rather than rediscovering the same bug for RADE V1 -- the sideband
      inversion is a property of the TX/RX hardware chain, not the FreeDV
      mode, so it should apply identically regardless of what''s being sent.'
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [624, 300.0]
    rotation: 0
    state: enabled

connections:
- [blocks_float_to_complex_0, '0', blocks_conjugate_cc_0, '0']
- [blocks_conjugate_cc_0, '0', rational_resampler_xxx_0, '0']
- [blocks_wavfile_source_0, '0', blocks_float_to_complex_0, '0']
- [blocks_wavfile_source_0, '1', blocks_float_to_complex_0, '1']
- [rational_resampler_xxx_0, '0', osmosdr_sink_0, '0']
- [rational_resampler_xxx_0, '0', qtgui_freq_sink_x_0, '0']

metadata:
  file_format: 1
  grc_version: 3.10.12.0
