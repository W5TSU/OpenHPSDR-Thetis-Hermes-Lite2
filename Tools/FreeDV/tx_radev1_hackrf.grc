options:
  parameters:
    alias: ''
    author: W5TSU
    catch_exceptions: 'True'
    comment: 'Transmits Tools/FreeDV/radev1_test_iq_long.wav (126.3s of real RADE
      V1 modem audio, generated by the local freedv-gui checkout''s own TX
      pipeline -- ''\''freedv -ut tx -utmode RADEV1 -txfile <speech>
      -txoutfile <modem>\'' -- run 10 times over ~12s chunks of the source
      speech and concatenated, since a single invocation on the full 112s
      speech file mysteriously truncated to ~15s of output (not yet
      root-caused, third-party code -- chunking sidesteps it); then
      re-synthesized to I/Q via make_fdv_test_iq.py --input-wav --peak-dbfs -6)
      over the air via HackRF, as a positive-control test of Thetis''s RADE V1
      RX chain -- FreeDV-Plan.md Stage C. Generated already at -6 dBFS (learned
      from the 700E flowgraph''s DAC-quantization bug, see tx_700e_hackrf.grc),
      so no extra digital gain block needed here. TX gain defaults to 20dB VGA,
      the level that worked for both the 700E and the first (14.85s) RADE V1
      positive control -- raise/lower while watching the spectrum plot and
      Thetis''s RADE status. Follow Part 97 identification rules: ID at start
      and end of transmission (this signal is RADE-encoded test speech, not
      an ID by itself).'
    copyright: ''
    description: RADE V1 over-the-air positive-control TX test for the HL2/Thetis
      FreeDV branch
    gen_linking: dynamic
    generate_options: qt_gui
    generator_class_name: PythonQtGuiGenerator
    generator_module: gnuradio.grc.workflows.python_qt_gui
    hier_block_src_path: '.:'
    id: tx_radev1_hackrf
    max_nouts: '0'
    output_language: python
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    thread_safe_setters: ''
    title: FreeDV RADE V1 -- HackRF TX (positive control)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [10, 10]
    rotation: 0
    state: enabled

blocks:
- name: samp_rate
  id: variable
  parameters:
    comment: HackRF TX sample rate -- below ~2 Msps the driver/quality gets unreliable,
      so this resamples up from the wav's native 48 kHz rather than transmitting at
      48 kHz directly. 50x the wav rate, a clean integer interpolation ratio.
    value: wav_samp_rate * 50
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [180, 10]
    rotation: 0
    state: enabled
- name: tx_gain
  id: variable_qtgui_range
  parameters:
    comment: HackRF VGA (IF) gain. Defaults to 20dB, the level that got the 700E
      positive control to sync -- Part 97 minimum-necessary-power practice still
      applies, so start here and only raise further if RADE V1 doesn't sync at
      this level (its signal statistics/bandwidth differ from 700E's).
    gui_hint: 0,1,1,1
    label: TX VGA Gain (dB)
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: int
    start: '0'
    step: '1'
    stop: '47'
    value: '20'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [500, 10]
    rotation: 0
    state: enabled
- name: wav_samp_rate
  id: variable
  parameters:
    comment: Native rate of the I/Q wav (make_fdv_test_iq.py's --rate-out, default
      48000)
    value: '48000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [24, 172.0]
    rotation: 0
    state: enabled
- name: blocks_float_to_complex_0
  id: blocks_float_to_complex
  parameters:
    affinity: ''
    alias: ''
    comment: left (I) -> real, right (Q) -> imag -- matches make_fdv_test_iq.py's
      own left=I/right=Q wav layout.
    maxoutbuf: '0'
    minoutbuf: '0'
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [416, 216.0]
    rotation: 0
    state: enabled
- name: blocks_wavfile_source_0
  id: blocks_wavfile_source
  parameters:
    affinity: ''
    alias: ''
    comment: Plays once and stops -- no repeat, so this is a single, bounded
      transmission rather than something that could be left running
      unattended. 126.3s -- see the top-level comment for how this longer
      version was built (10 chunked freedv-gui TX runs, concatenated).
    file: in_file
    maxoutbuf: '0'
    minoutbuf: '0'
    nchan: '2'
    repeat: 'False'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [200, 220.0]
    rotation: 0
    state: enabled
- name: center_freq
  id: parameter
  parameters:
    alias: ''
    comment: 20m ham band, matches the calling frequency used for the earlier off-air
      RADE V1 monitoring (freedv-calling-frequencies) -- change if you want a different
      dial frequency, just keep it inside the amateur allocation for your license
      class.
    hide: none
    label: Center Frequency (Hz)
    short_id: ''
    type: eng_float
    value: '14236000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [300, 10]
    rotation: 0
    state: enabled
- name: in_file
  id: parameter
  parameters:
    alias: ''
    comment: Real RADE V1 modem audio (from freedv-gui's own encoder) re-synthesized
      to I/Q -- left=I, right=Q, 48 kHz float32, -6 dBFS peak, 126.3s (chunked
      generation, see the top-level comment). Regenerate per
      Tools/FreeDV/README.md if missing (gitignored, not committed).
    hide: none
    label: RADE V1 I/Q wav (from make_fdv_test_iq.py --input-wav)
    short_id: ''
    type: str
    value: '"radev1_test_iq_long.wav"'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [700, 10]
    rotation: 0
    state: enabled
